[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.34,
  "text": "What If You Had 1000 IQ?"
 },
 {
  "i": 1,
  "start": 3.0,
  "end": 4.52,
  "text": "You glance at the chessboard once."
 },
 {
  "i": 2,
  "start": 5.04,
  "end": 7.22,
  "text": "You already see the next forty moves."
 },
 {
  "i": 3,
  "start": 7.88,
  "end": 10.52,
  "text": "Your teacher writes a six digit multiplication on the board."
 },
 {
  "i": 4,
  "start": 10.94,
  "end": 12.84,
  "text": "You answer before she drops the chalk."
 },
 {
  "i": 5,
  "start": 13.4,
  "end": 15.7,
  "text": "Your friend Leo hands you a tangled charger cable."
 },
 {
  "i": 6,
  "start": 16.14,
  "end": 16.86,
  "text": "You hand it back..."
 },
 {
  "i": 7,
  "start": 17.32,
  "end": 17.76,
  "text": "untangled..."
 },
 {
  "i": 8,
  "start": 18.04,
  "end": 18.96,
  "text": "in two seconds."
 },
 {
  "i": 9,
  "start": 19.48,
  "end": 25.0,
  "text": "The bus timetable, the weather, the crossword, the crowd’s exact head count."
 },
 {
  "i": 10,
  "start": 25.0,
  "end": 25.24,
  "text": "Done."
 },
 {
  "i": 11,
  "start": 25.7,
  "end": 25.92,
  "text": "Done."
 },
 {
  "i": 12,
  "start": 26.4,
  "end": 26.6,
  "text": "Done."
 },
 {
  "i": 13,
  "start": 26.6,
  "end": 26.7,
  "text": "Done."
 },
 {
  "i": 14,
  "start": 27.06,
  "end": 27.8,
  "text": "And your toast..."
 },
 {
  "i": 15,
  "start": 27.8,
  "end": 29.4,
  "text": "is still in the toaster."
 },
 {
  "i": 16,
  "start": 30.0,
  "end": 32.96,
  "text": "The average human scores around one hundred on an IQ test."
 },
 {
  "i": 17,
  "start": 33.4,
  "end": 36.52,
  "text": "The smartest people ever measured hover near two hundred."
 },
 {
  "i": 18,
  "start": 36.52,
  "end": 36.82,
  "text": "You?"
 },
 {
  "i": 19,
  "start": 36.82,
  "end": 38.5,
  "text": "One thousand."
 },
 {
  "i": 20,
  "start": 38.5,
  "end": 40.3,
  "text": "Five times past the edge of the chart."
 },
 {
  "i": 21,
  "start": 40.7,
  "end": 41.46,
  "text": "But here’s the rule."
 },
 {
  "i": 22,
  "start": 41.96,
  "end": 43.06,
  "text": "Your brain got faster."
 },
 {
  "i": 23,
  "start": 43.44,
  "end": 44.68,
  "text": "Your body didn’t."
 },
 {
  "i": 24,
  "start": 44.68,
  "end": 46.8,
  "text": "You can calculate a falling glass perfectly..."
 },
 {
  "i": 25,
  "start": 46.8,
  "end": 49.58,
  "text": "and still be half a second too slow to catch it."
 },
 {
  "i": 26,
  "start": 50.08,
  "end": 52.28,
  "text": "So what if you had one thousand IQ?"
 },
 {
  "i": 27,
  "start": 52.28,
  "end": 56.02,
  "text": "At school, you finish a two hour exam in four minutes."
 },
 {
  "i": 28,
  "start": 56.72,
  "end": 58.72,
  "text": "Leo stares at your blank extra time."
 },
 {
  "i": 29,
  "start": 59.2,
  "end": 59.32,
  "text": "Dude."
 },
 {
  "i": 30,
  "start": 59.64,
  "end": 60.6,
  "text": "You just sat there."
 },
 {
  "i": 31,
  "start": 61.02,
  "end": 63.14,
  "text": "I was proving it three more ways, you say."
 },
 {
  "i": 32,
  "start": 63.56,
  "end": 63.94,
  "text": "For fun."
 },
 {
  "i": 33,
  "start": 64.52,
  "end": 67.24,
  "text": "Plus: you learn a new language over one lunch period."
 },
 {
  "i": 34,
  "start": 67.74,
  "end": 70.16,
  "text": "Grammar, verbs, slang, done by dessert."
 },
 {
  "i": 35,
  "start": 70.88,
  "end": 75.3,
  "text": "Minus: you also notice every tiny lie people tell without meaning to."
 },
 {
  "i": 36,
  "start": 75.82,
  "end": 77.18,
  "text": "Your mom says dinner’s almost ready."
 },
 {
  "i": 37,
  "start": 77.64,
  "end": 78.94,
  "text": "It is not almost ready."
 },
 {
  "i": 38,
  "start": 79.3,
  "end": 80.7,
  "text": "You know this from the pan sounds."
 },
 {
  "i": 39,
  "start": 81.24,
  "end": 84.32,
  "text": "In chess club, you beat the state champion in nine moves."
 },
 {
  "i": 40,
  "start": 84.8,
  "end": 85.7,
  "text": "He stares at the board."
 },
 {
  "i": 41,
  "start": 86.88,
  "end": 87.26,
  "text": "How..."
 },
 {
  "i": 42,
  "start": 87.26,
  "end": 88.06,
  "text": "how did you do that?"
 },
 {
  "i": 43,
  "start": 88.52,
  "end": 89.52,
  "text": "I didn’t, you say."
 },
 {
  "i": 44,
  "start": 89.88,
  "end": 90.46,
  "text": "The board did."
 },
 {
  "i": 45,
  "start": 90.84,
  "end": 91.54,
  "text": "I just read it."
 },
 {
  "i": 46,
  "start": 91.86,
  "end": 93.3,
  "text": "But where it gets really crazy..."
 },
 {
  "i": 47,
  "start": 93.3,
  "end": 94.42,
  "text": "is the systems."
 },
 {
  "i": 48,
  "start": 95.04,
  "end": 98.4,
  "text": "You glance at a stock chart once and see the crash three days early."
 },
 {
  "i": 49,
  "start": 98.76,
  "end": 103.66,
  "text": "You look at your city’s traffic lights and redesign the timing in your head, cutting the morning jam in half."
 },
 {
  "i": 50,
  "start": 104.12,
  "end": 106.56,
  "text": "A real engineer would need a team, and months."
 },
 {
  "i": 51,
  "start": 107.06,
  "end": 108.24,
  "text": "You needed a red light."
 },
 {
  "i": 52,
  "start": 108.24,
  "end": 110.7,
  "text": "And there’s a cost nobody warns you about."
 },
 {
  "i": 53,
  "start": 111.22,
  "end": 112.28,
  "text": "You can’t turn it off."
 },
 {
  "i": 54,
  "start": 112.72,
  "end": 112.96,
  "text": "Ever."
 },
 {
  "i": 55,
  "start": 113.4,
  "end": 116.52,
  "text": "The fridge hum becomes a frequency you calculate instead of ignore."
 },
 {
  "i": 56,
  "start": 117.02,
  "end": 119.78,
  "text": "The ceiling fan becomes a geometry problem at two in the morning."
 },
 {
  "i": 57,
  "start": 120.3,
  "end": 121.02,
  "text": "You lie there..."
 },
 {
  "i": 58,
  "start": 121.28,
  "end": 123.02,
  "text": "running numbers you never asked for..."
 },
 {
  "i": 59,
  "start": 123.28,
  "end": 124.6,
  "text": "while the whole street sleeps."
 },
 {
  "i": 60,
  "start": 125.22,
  "end": 128.36,
  "text": "A normal brain filters out ninety nine percent of what it senses."
 },
 {
  "i": 61,
  "start": 129.06,
  "end": 130.76,
  "text": "Yours filters out almost nothing."
 },
 {
  "i": 62,
  "start": 131.56,
  "end": 133.26,
  "text": "Mia, your lab partner, taps your shoulder."
 },
 {
  "i": 63,
  "start": 133.26,
  "end": 135.56,
  "text": "You’ve been staring at that wall for an hour."
 },
 {
  "i": 64,
  "start": 135.98,
  "end": 137.9,
  "text": "I was mapping the crack pattern, you say."
 },
 {
  "i": 65,
  "start": 137.9,
  "end": 139.56,
  "text": "It’s actually kind of beautiful."
 },
 {
  "i": 66,
  "start": 139.56,
  "end": 141.32,
  "text": "That’s the real price."
 },
 {
  "i": 67,
  "start": 141.9,
  "end": 145.48,
  "text": "Dopamine, the brain’s little reward spark, fires hardest for surprises."
 },
 {
  "i": 68,
  "start": 145.92,
  "end": 147.18,
  "text": "For things you didn’t see coming."
 },
 {
  "i": 69,
  "start": 147.6,
  "end": 149.2,
  "text": "But you always see it coming."
 },
 {
  "i": 70,
  "start": 149.58,
  "end": 150.36,
  "text": "The movie twist."
 },
 {
  "i": 71,
  "start": 150.7,
  "end": 151.4,
  "text": "The pop quiz."
 },
 {
  "i": 72,
  "start": 151.68,
  "end": 152.6,
  "text": "The surprise party."
 },
 {
  "i": 73,
  "start": 152.82,
  "end": 153.98,
  "text": "All solved in advance."
 },
 {
  "i": 74,
  "start": 154.56,
  "end": 155.1,
  "text": "Nothing left..."
 },
 {
  "i": 75,
  "start": 155.1,
  "end": 156.58,
  "text": "to feel surprised by."
 },
 {
  "i": 76,
  "start": 156.96,
  "end": 159.2,
  "text": "And Leo notices before anyone else does."
 },
 {
  "i": 77,
  "start": 159.2,
  "end": 161.02,
  "text": "He’s known you since you were seven."
 },
 {
  "i": 78,
  "start": 161.54,
  "end": 163.98,
  "text": "Same table, every lunch, for years."
 },
 {
  "i": 79,
  "start": 163.98,
  "end": 166.1,
  "text": "Same dumb knock on your door..."
 },
 {
  "i": 80,
  "start": 166.66,
  "end": 167.98,
  "text": "three taps, then one."
 },
 {
  "i": 81,
  "start": 168.42,
  "end": 170.08,
  "text": "He still does it, even now."
 },
 {
  "i": 82,
  "start": 170.52,
  "end": 172.96,
  "text": "One afternoon he finds you just sitting in the dark."
 },
 {
  "i": 83,
  "start": 173.5,
  "end": 176.5,
  "text": "You used to laugh at my terrible jokes, he says quietly."
 },
 {
  "i": 84,
  "start": 177.0,
  "end": 177.7,
  "text": "Now you just..."
 },
 {
  "i": 85,
  "start": 177.7,
  "end": 179.28,
  "text": "solve them before I finish."
 },
 {
  "i": 86,
  "start": 179.88,
  "end": 181.16,
  "text": "I miss confusing you."
 },
 {
  "i": 87,
  "start": 181.52,
  "end": 183.4,
  "text": "That hits harder than any equation."
 },
 {
  "i": 88,
  "start": 183.96,
  "end": 185.76,
  "text": "Then an organization shows up."
 },
 {
  "i": 89,
  "start": 186.26,
  "end": 186.68,
  "text": "Sharp suits."
 },
 {
  "i": 90,
  "start": 187.16,
  "end": 187.78,
  "text": "Soft voices."
 },
 {
  "i": 91,
  "start": 188.3,
  "end": 189.22,
  "text": "A man named Mr."
 },
 {
  "i": 92,
  "start": 189.58,
  "end": 192.24,
  "text": "Black offers you a lab, a salary, a future."
 },
 {
  "i": 93,
  "start": 192.24,
  "end": 194.66,
  "text": "Just solve our market models, he says."
 },
 {
  "i": 94,
  "start": 195.28,
  "end": 195.62,
  "text": "Nothing illegal."
 },
 {
  "i": 95,
  "start": 196.02,
  "end": 196.28,
  "text": "Just..."
 },
 {
  "i": 96,
  "start": 196.28,
  "end": 197.04,
  "text": "profitable."
 },
 {
  "i": 97,
  "start": 197.6,
  "end": 199.94,
  "text": "You could predict every trade on Earth by lunch."
 },
 {
  "i": 98,
  "start": 200.44,
  "end": 201.72,
  "text": "You could be rich by Friday."
 },
 {
  "i": 99,
  "start": 202.28,
  "end": 202.66,
  "text": "The catch?"
 },
 {
  "i": 100,
  "start": 203.22,
  "end": 204.36,
  "text": "Their numbers don’t add up."
 },
 {
  "i": 101,
  "start": 204.74,
  "end": 205.5,
  "text": "You run them twice."
 },
 {
  "i": 102,
  "start": 206.02,
  "end": 208.66,
  "text": "Real people lose their savings so the firm wins."
 },
 {
  "i": 103,
  "start": 209.22,
  "end": 212.6,
  "text": "Written across one folder, in someone’s shaky hand: Pension."
 },
 {
  "i": 104,
  "start": 213.34,
  "end": 213.98,
  "text": "Last savings."
 },
 {
  "i": 105,
  "start": 214.6,
  "end": 216.08,
  "text": "Then the emergency comes."
 },
 {
  "i": 106,
  "start": 216.08,
  "end": 220.92,
  "text": "Leo’s apartment building, old wiring, and a spark catches in a stairwell at midnight."
 },
 {
  "i": 107,
  "start": 220.92,
  "end": 222.42,
  "text": "You’re three streets away."
 },
 {
  "i": 108,
  "start": 222.88,
  "end": 224.84,
  "text": "You calculate the fire’s spread rate instantly..."
 },
 {
  "i": 109,
  "start": 225.28,
  "end": 226.78,
  "text": "two meters every eight seconds..."
 },
 {
  "i": 110,
  "start": 227.14,
  "end": 228.94,
  "text": "the exits closing in under two minutes."
 },
 {
  "i": 111,
  "start": 229.38,
  "end": 230.28,
  "text": "You could run the model."
 },
 {
  "i": 112,
  "start": 230.66,
  "end": 231.68,
  "text": "Or you could run."
 },
 {
  "i": 113,
  "start": 232.1,
  "end": 232.94,
  "text": "The genius thing..."
 },
 {
  "i": 114,
  "start": 233.28,
  "end": 234.14,
  "text": "or the right thing."
 },
 {
  "i": 115,
  "start": 234.5,
  "end": 235.0,
  "text": "You run."
 },
 {
  "i": 116,
  "start": 235.4,
  "end": 244.98,
  "text": "You take the stairs two at a time, dragging a confused family past the smoke, finding Leo by the one window still clear, hauling him out seconds before the hallway folds in on itself."
 },
 {
  "i": 117,
  "start": 245.5,
  "end": 248.7,
  "text": "Outside, soot on your face, Leo coughs out a laugh."
 },
 {
  "i": 118,
  "start": 249.06,
  "end": 250.3,
  "text": "Still think I’m not surprising?"
 },
 {
  "i": 119,
  "start": 250.72,
  "end": 251.92,
  "text": "You actually grin."
 },
 {
  "i": 120,
  "start": 252.52,
  "end": 252.98,
  "text": "That one..."
 },
 {
  "i": 121,
  "start": 253.36,
  "end": 254.34,
  "text": "I didn’t see coming."
 },
 {
  "i": 122,
  "start": 254.88,
  "end": 255.46,
  "text": "You hand Mr."
 },
 {
  "i": 123,
  "start": 255.46,
  "end": 257.88,
  "text": "Black’s folder to a reporter instead of his lab."
 },
 {
  "i": 124,
  "start": 258.26,
  "end": 259.8,
  "text": "The firm collapses within a week."
 },
 {
  "i": 125,
  "start": 260.2,
  "end": 261.32,
  "text": "The savings get returned."
 },
 {
  "i": 126,
  "start": 261.74,
  "end": 263.84,
  "text": "You could have been richer than anyone alive."
 },
 {
  "i": 127,
  "start": 264.36,
  "end": 265.66,
  "text": "Instead, you’re just..."
 },
 {
  "i": 128,
  "start": 265.66,
  "end": 268.26,
  "text": "Leo’s friend again, three knocks and all."
 },
 {
  "i": 129,
  "start": 268.66,
  "end": 272.76,
  "text": "And for the first time in months, his terrible joke actually catches you off guard."
 },
 {
  "i": 130,
  "start": 273.2,
  "end": 274.92,
  "text": "You laugh, right on time."
 },
 {
  "i": 131,
  "start": 275.38,
  "end": 276.48,
  "text": "Is any of this real?"
 },
 {
  "i": 132,
  "start": 276.9,
  "end": 280.68,
  "text": "Nobody has ever scored anywhere near one thousand on an IQ test..."
 },
 {
  "i": 133,
  "start": 281.1,
  "end": 283.44,
  "text": "the scale basically stops making sense that high."
 },
 {
  "i": 134,
  "start": 283.8,
  "end": 288.02,
  "text": "The highest ever recorded, by most estimates, sits closer to two hundred."
 },
 {
  "i": 135,
  "start": 288.02,
  "end": 290.94,
  "text": "And real intelligence was never just raw calculation."
 },
 {
  "i": 136,
  "start": 290.94,
  "end": 291.94,
  "text": "It’s judgment."
 },
 {
  "i": 137,
  "start": 291.94,
  "end": 293.56,
  "text": "It’s knowing what matters."
 },
 {
  "i": 138,
  "start": 294.22,
  "end": 299.48,
  "text": "Scientists still argue over what IQ even measures, and whether any number could capture a mind completely."
 },
 {
  "i": 139,
  "start": 299.98,
  "end": 302.38,
  "text": "So could a mind really get that fast..."
 },
 {
  "i": 140,
  "start": 302.38,
  "end": 303.96,
  "text": "and still stay kind?"
 },
 {
  "i": 141,
  "start": 304.44,
  "end": 306.34,
  "text": "That night, your phone buzzes."
 },
 {
  "i": 142,
  "start": 306.64,
  "end": 307.2,
  "text": "Unknown number."
 },
 {
  "i": 143,
  "start": 307.64,
  "end": 308.12,
  "text": "One line."
 },
 {
  "i": 144,
  "start": 308.44,
  "end": 309.44,
  "text": "We know what you did."
 },
 {
  "i": 145,
  "start": 309.98,
  "end": 310.74,
  "text": "We have a proposal."
 },
 {
  "i": 146,
  "start": 311.5,
  "end": 313.2,
  "text": "You stare at it a long time..."
 },
 {
  "i": 147,
  "start": 313.94,
  "end": 314.92,
  "text": "then set it face down."
 },
 {
  "i": 148,
  "start": 315.48,
  "end": 318.56,
  "text": "So what would you actually solve first with a mind like that?"
 },
 {
  "i": 149,
  "start": 318.98,
  "end": 321.12,
  "text": "Tell us the one problem you’d fix by lunchtime."
 },
 {
  "i": 150,
  "start": 321.7,
  "end": 324.4,
  "text": "And if Leo’s three knock code got you right in the feels..."
 },
 {
  "i": 151,
  "start": 324.8,
  "end": 327.16,
  "text": "hit like, and subscribe for more What Ifs."
 }
]